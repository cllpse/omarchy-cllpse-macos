# Linux build of the Midi Fighter Twister firmware, from the flags in
# Midi_Fighter_Twister.cproj / Release/Makefile (Atmel Studio's generated one),
# minus the Windows paths and the DFP pack: avr-libc ships the ATxmega128A4U
# header and avr-gcc the device spec.
#
#   make            -> build/twister.hex (+ .elf, size report)
#   make flash      -> dfu-programmer, after the device was told to jump to its
#                      bootloader (see README-linux-build.md)
CC       = avr-gcc
OBJCOPY  = avr-objcopy
SIZE     = avr-size
MCU      = atxmega128a4u
BUILD    = build
DEFS     = -DF_USB=48000000UL -DF_CPU=32000000UL -DBOARD=USER_BOARD -DUSE_LUFA_CONFIG_HEADER -DARCH=ARCH_XMEGA
INCS     = -Isrc -Isrc/ASF/common/boards/user_board -Isrc/config -Isrc/ASF/common/boards \
           -Isrc/ASF/common/services/fifo -Isrc/ASF/common/services/hugemem \
           -Isrc/ASF/xmega/drivers/cpu -Isrc/ASF/xmega/drivers/dma -Isrc/ASF/xmega/drivers/nvm \
           -Isrc/ASF/xmega/drivers/pmic -Isrc/ASF/xmega/drivers/sleep -Isrc/ASF/xmega/drivers/tc \
           -Isrc/ASF/xmega/drivers/wdt -Isrc/ASF/common/drivers/nvm -Isrc/ASF/common/services/clock \
           -Isrc/ASF/common/services/delay -Isrc/ASF/common/services/ioport \
           -Isrc/ASF/common/services/serial/xmega_usart -Isrc/ASF/common/services/serial \
           -Isrc/ASF/common/services/sleepmgr -Isrc/ASF/common/utils -Isrc/ASF/xmega/drivers/usart \
           -Isrc/ASF/xmega/utils/preprocessor -Isrc/ASF/xmega/utils -Isrc/LUFA
CFLAGS   = -x c $(DEFS) $(INCS) -fcommon -Os -fdata-sections -ffunction-sections -Wall -mmcu=$(MCU) \
           -std=gnu99 -fno-strict-aliasing -Wstrict-prototypes -Wmissing-prototypes \
           -Werror-implicit-function-declaration -Wpointer-arith -mrelax -MMD -MP
LDFLAGS  = -Wl,--start-group -Wl,-lm -Wl,--end-group -Wl,--gc-sections -mrelax -mmcu=$(MCU)
SRCS = \
  src/ASF/common/drivers/nvm/xmega/xmega_nvm.c \
  src/ASF/common/services/clock/xmega/sysclk.c \
  src/ASF/common/services/fifo/fifo.c \
  src/ASF/common/services/hugemem/avr8/avr8_hugemem.c \
  src/ASF/common/services/ioport/xmega/ioport_compat.c \
  src/ASF/common/services/serial/usart_serial.c \
  src/ASF/common/services/sleepmgr/xmega/sleepmgr.c \
  src/ASF/xmega/drivers/dma/dma.c \
  src/ASF/xmega/drivers/nvm/nvm.c \
  src/ASF/xmega/drivers/tc/tc.c \
  src/ASF/xmega/drivers/usart/usart.c \
  src/ASF/xmega/drivers/wdt/wdt.c \
  src/colorMap.c \
  src/config.c \
  src/eeprom.c \
  src/jump_to_bootloader.c \
  src/LUFA/LUFA/Drivers/USB/Class/Common/HIDParser.c \
  src/LUFA/LUFA/Drivers/USB/Class/Device/AudioClassDevice.c \
  src/LUFA/LUFA/Drivers/USB/Class/Device/CDCClassDevice.c \
  src/LUFA/LUFA/Drivers/USB/Class/Device/HIDClassDevice.c \
  src/LUFA/LUFA/Drivers/USB/Class/Device/MassStorageClassDevice.c \
  src/LUFA/LUFA/Drivers/USB/Class/Device/MIDIClassDevice.c \
  src/LUFA/LUFA/Drivers/USB/Class/Device/PrinterClassDevice.c \
  src/LUFA/LUFA/Drivers/USB/Class/Device/RNDISClassDevice.c \
  src/LUFA/LUFA/Drivers/USB/Class/Host/AndroidAccessoryClassHost.c \
  src/LUFA/LUFA/Drivers/USB/Class/Host/AudioClassHost.c \
  src/LUFA/LUFA/Drivers/USB/Class/Host/CDCClassHost.c \
  src/LUFA/LUFA/Drivers/USB/Class/Host/HIDClassHost.c \
  src/LUFA/LUFA/Drivers/USB/Class/Host/MassStorageClassHost.c \
  src/LUFA/LUFA/Drivers/USB/Class/Host/MIDIClassHost.c \
  src/LUFA/LUFA/Drivers/USB/Class/Host/PrinterClassHost.c \
  src/LUFA/LUFA/Drivers/USB/Class/Host/RNDISClassHost.c \
  src/LUFA/LUFA/Drivers/USB/Class/Host/StillImageClassHost.c \
  src/LUFA/LUFA/Drivers/USB/Core/ConfigDescriptors.c \
  src/LUFA/LUFA/Drivers/USB/Core/DeviceStandardReq.c \
  src/LUFA/LUFA/Drivers/USB/Core/Events.c \
  src/LUFA/LUFA/Drivers/USB/Core/HostStandardReq.c \
  src/LUFA/LUFA/Drivers/USB/Core/USBTask.c \
  src/LUFA/LUFA/Drivers/USB/Core/XMEGA/Device_XMEGA.c \
  src/LUFA/LUFA/Drivers/USB/Core/XMEGA/EndpointStream_XMEGA.c \
  src/LUFA/LUFA/Drivers/USB/Core/XMEGA/Endpoint_XMEGA.c \
  src/LUFA/LUFA/Drivers/USB/Core/XMEGA/Pipe_XMEGA.c \
  src/LUFA/LUFA/Drivers/USB/Core/XMEGA/Template/Template_Endpoint_Control_R.c \
  src/LUFA/LUFA/Drivers/USB/Core/XMEGA/Template/Template_Endpoint_Control_W.c \
  src/LUFA/LUFA/Drivers/USB/Core/XMEGA/Template/Template_Endpoint_RW.c \
  src/LUFA/LUFA/Drivers/USB/Core/XMEGA/USBController_XMEGA.c \
  src/LUFA/LUFA/Drivers/USB/Core/XMEGA/USBInterrupt_XMEGA.c \
  src/self_test.c \
  src/sequencer.c \
  src/sequencer_display.c \
  src/sequencer_input.c \
  src/sysex.c \
  src/side_switch.c \
  src/native_mode.c \
  src/encoders.c \
  src/midi.c \
  src/Descriptors.c \
  src/display_driver.c \
  src/input.c \
  src/main.c \
  src/ASF/common/boards/user_board/init.c \

ASRCS = src/ASF/xmega/drivers/nvm/nvm_asm.s
OBJS = $(addprefix $(BUILD)/,$(SRCS:.c=.o) $(ASRCS:.s=.o))

all: $(BUILD)/twister.hex

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD)/%.o: %.s
	@mkdir -p $(dir $@)
	$(CC) -x assembler-with-cpp $(DEFS) $(INCS) -mmcu=$(MCU) -c -o $@ $<

$(BUILD)/twister.elf: $(OBJS)
	$(CC) -o $@ $(OBJS) $(LDFLAGS) -Wl,-Map=$(BUILD)/twister.map
	$(SIZE) $@

$(BUILD)/twister.hex: $(BUILD)/twister.elf
	$(OBJCOPY) -O ihex -R .eeprom -R .fuse -R .lock -R .signature -R .user_signatures $< $@

flash: $(BUILD)/twister.hex
	dfu-programmer $(MCU) erase --force
	dfu-programmer $(MCU) flash $<
	dfu-programmer $(MCU) launch

clean:
	rm -rf $(BUILD)

-include $(OBJS:.o=.d)
.PHONY: all flash clean
