+static uint8_t next_cycle_color(uint8_t current);
+static uint8_t next_cycle_color(uint8_t current)
+{
+	for (uint8_t k = 0; k < NUM_CYCLE_COLORS; ++k) {
+		if (pgm_read_byte(&cycle_colors[k]) == current) {
+			return pgm_read_byte(&cycle_colors[(k + 1) % NUM_CYCLE_COLORS]);
+		}
+	}
+	return pgm_read_byte(&cycle_colors[0]); // not a palette colour yet: start at the first
