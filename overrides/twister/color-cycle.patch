+// cllpse: one-shot animations, played by a SW_COLOR_TOGGLE press. Two kinds:
+// six "local" ones on the pressed encoder alone, and four "global" colour
+// shifts across all sixteen LEDs; every third press is a global one, each
+// set taken in turn so successive presses differ. ONESHOT_MS each, drawn
+// straight into the frame buffer from the main loop like the stock
+// animations; the normal display is forced to redraw when one ends.
+#define ONESHOT_MS 2000
+#define NUM_ONESHOTS 6
+#define NUM_GLOBAL_ANIMS 4
+static uint8_t  anim_presses = 0;      // every third press is global
+static uint16_t global_start = 0;
+static uint8_t  global_kind = 0, global_next = 0;
+static uint8_t  global_origin = 0;     // the pressed encoder, for the ripple and the spotlight
+static bool     global_active = false;
+static uint16_t oneshot_start[16];
+static uint8_t  oneshot_kind[16];
+static uint16_t oneshot_pattern[16];
+static uint8_t  oneshot_frame_no[16];
+static uint16_t oneshot_active = 0;  // bitfield by physical encoder
+static uint8_t  oneshot_next = 0;
+static uint16_t oneshot_rng = 0xACE1;
+
+static uint16_t now_ms(void);
+static uint16_t now_ms(void) { irqflags_t f = cpu_irq_save(); uint16_t v = ms_ticks; cpu_irq_restore(f); return v; }
+static uint16_t rng16(void);
+static uint16_t rng16(void) { oneshot_rng ^= oneshot_rng << 7; oneshot_rng ^= oneshot_rng >> 9; oneshot_rng ^= oneshot_rng << 8; return oneshot_rng; }
+// ring positions 0 (7 o'clock) .. 10 (5 o'clock); 5 is 12 o'clock
+static uint16_t ring_dot(int8_t p);
+static uint16_t ring_dot(int8_t p) { return (p < 0 || p > 10) ? 0 : (uint16_t)(0x8000u >> p); }
+static uint16_t ring_span(int8_t a, int8_t b);
+static uint16_t ring_span(int8_t a, int8_t b) { uint16_t m = 0; for (int8_t p = a; p <= b; ++p) m |= ring_dot(p); return m; }
+// triangle wave 0..255..0 over `period` ms
+static uint8_t tri(uint16_t t, uint16_t period);
+static uint8_t tri(uint16_t t, uint16_t period) { uint16_t ph = t % period; uint16_t half = period / 2; return (uint8_t)((ph < half ? ph : period - ph) * 255UL / half); }
+
+static void oneshot_begin(uint8_t idx);
+static void oneshot_begin(uint8_t idx)
+{
+	oneshot_start[idx] = now_ms();
+	oneshot_kind[idx] = oneshot_next;
+	oneshot_next = (oneshot_next + 1) % NUM_ONESHOTS;
+	oneshot_frame_no[idx] = 0xFF;
+	oneshot_active |= (1 << idx);
+}
+
+static void anim_trigger(uint8_t idx);
+static void anim_trigger(uint8_t idx)
+{
+	if (++anim_presses % 3 == 0) {
+		global_start = now_ms();
+		global_kind = global_next;
+		global_next = (global_next + 1) % NUM_GLOBAL_ANIMS;
+		global_origin = idx;
+		global_active = true;
+	} else {
+		oneshot_begin(idx);
+	}
+}
+
+// One LED of a global colour shift. Only the RGB LED and its red/blue tint
+// move; the rings stay as they are.
+static void global_draw(uint8_t idx, uint16_t t, uint8_t own_color);
+static void global_draw(uint8_t idx, uint16_t t, uint8_t own_color)
+{
+	uint8_t rgbb = pgm_read_byte(&brightnessMap[global_rgb_brightness]);
+	uint8_t row = idx / 4, col = idx % 4;
+	uint8_t c; uint8_t lv = rgbb;
+	switch (global_kind) {
+	case 0: { // wave: a rainbow rolls across the grid, two full wheels in the two seconds
+		c = 1 + (uint8_t)((t / 8 + col * 20 + row * 10) % 118);
+	} break;
+	case 1: { // ripple: hue and brightness radiate from the pressed knob by grid distance
+		uint8_t r0 = global_origin / 4, c0 = global_origin % 4;
+		uint8_t d = (uint8_t)((row > r0 ? row - r0 : r0 - row) + (col > c0 ? col - c0 : c0 - col)); // 0..6
+		c = 1 + (uint8_t)((t / 6 + (6 - d) * 18) % 118);
+		lv = (uint8_t)(((uint16_t)tri((uint16_t)(t + d * 90), 540) * rgbb) / 255); if (lv < 4) lv = 4;
+	} break;
+	case 2: { // twinkle: every LED jumps to a new colour and level every 100 ms
+		uint8_t fr = (uint8_t)(t / 100);
+		uint16_t h = (uint16_t)(fr * 37u + idx * 53u + fr * idx * 7u);
+		c = 1 + (uint8_t)(h % 118);
+		lv = (uint8_t)(((uint16_t)(40 + (h >> 3) % 88) * rgbb) / 127);
+	} break;
+	default: { // spotlight: every LED takes the pressed knob's colour and breathes, the pressed one solid
+		c = own_color ? own_color : 1;
+		if (idx != global_origin) lv = (uint8_t)(((uint16_t)tri(t, 1000) * rgbb) / 255);
+	} break;
+	}
+	set_encoder_rgb_level(idx, c, lv);
+	uint32_t rgb = pgm_read_dword(&activeColorMap[c][0]);
+	set_encoder_indent_rgb(idx, (uint8_t)(((uint16_t)((rgb >> 16) & 0xFF) * lv) / 127), (uint8_t)(((uint16_t)(rgb & 0xFF) * lv) / 127));
+}
+
+static void oneshot_draw(uint8_t idx, uint16_t t, uint8_t color, uint8_t red, uint8_t blue);
+static void oneshot_draw(uint8_t idx, uint16_t t, uint8_t color, uint8_t red, uint8_t blue)
+{
+	uint8_t indb = pgm_read_byte(&brightnessMap[global_ind_brightness]);
+	uint8_t rgbb = pgm_read_byte(&brightnessMap[global_rgb_brightness]);
+	switch (oneshot_kind[idx]) {
+	case 0: { // spin: a dot laps the ring every 330 ms, the LED breathes at 2 Hz
+		set_indicator_pattern_level(idx, ring_dot((t / 30) % 11), indb);
+		set_encoder_rgb_level(idx, color, (uint8_t)(((uint16_t)tri(t, 500) * rgbb) / 255));
+		set_encoder_indent_rgb(idx, red, blue);
+	} break;
+	case 1: { // burst: a spread from 12 o'clock out to the full ring and back, four times, the LED strobing
+		uint16_t ph = t % 500; uint8_t w = (uint8_t)((ph < 250 ? ph : 499 - ph) / 42);
+		set_indicator_pattern_level(idx, ring_span(5 - w, 5 + w), indb);
+		set_encoder_rgb_level(idx, color, ((t / 62) & 1) ? rgbb : 0);
+		set_encoder_indent_rgb(idx, red, blue);
+	} break;
+	case 2: { // rainbow: the LED sweeps the hue wheel twice while the whole ring breathes
+		uint8_t c = 1 + (uint8_t)(((uint32_t)(t % 1000) * 118) / 1000);
+		uint8_t lv = (uint8_t)(((uint16_t)tri(t, 1000) * indb) / 255); if (lv < 2) lv = 2;
+		set_indicator_pattern_level(idx, ring_span(0, 10), lv);
+		set_encoder_rgb_level(idx, c, rgbb);
+		uint32_t rgb = pgm_read_dword(&activeColorMap[c][0]);
+		set_encoder_indent_rgb(idx, (rgb >> 16) & 0xFF, rgb & 0xFF);
+	} break;
+	case 3: { // bounce: a dot bounces end to end every 400 ms, the red/blue LED alternates
+		uint16_t ph = t % 400; int8_t p = (int8_t)((ph < 200 ? ph : 399 - ph) / 19);
+		set_indicator_pattern_level(idx, ring_dot(p), indb);
+		set_encoder_rgb_level(idx, color, rgbb);
+		if ((t / 100) & 1) set_encoder_indent_rgb(idx, 255, 0); else set_encoder_indent_rgb(idx, 0, 255);
+	} break;
+	case 4: { // fill: the bar fills from the left in half a second, then drains from the left, twice; the LED follows the level
+		uint16_t ph = t % 1000; uint8_t n = (uint8_t)((ph < 500 ? ph : ph - 500) / 45); if (n > 11) n = 11;
+		uint16_t m = ph < 500 ? ring_span(0, (int8_t)n - 1) : ring_span((int8_t)n, 10);
+		uint8_t lv = ph < 500 ? n : 11 - n;
+		set_indicator_pattern_level(idx, m, indb);
+		set_encoder_rgb_level(idx, color, (uint8_t)(((uint16_t)lv * rgbb) / 11));
+		set_encoder_indent_rgb(idx, red, blue);
+	} break;
+	default: { // sparkle: three random ring LEDs every 50 ms, the LED white and flickering
+		uint8_t fr = (uint8_t)(t / 50);
+		if (fr != oneshot_frame_no[idx]) {
+			oneshot_frame_no[idx] = fr;
+			uint16_t r = rng16();
+			oneshot_pattern[idx] = ring_dot(r % 11) | ring_dot((r >> 4) % 11) | ring_dot((r >> 8) % 11);
+			set_encoder_rgb_level(idx, 127, (uint8_t)(((uint16_t)(32 + (r & 0x5F)) * rgbb) / 127));
+		}
+		set_indicator_pattern_level(idx, oneshot_pattern[idx], indb);
+		set_encoder_indent_rgb(idx, red, blue);
+	} break;
+	}
+}
