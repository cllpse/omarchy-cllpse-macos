+static void save_inactive_color(uint8_t bank, uint8_t encoder, uint8_t color);
+static void save_inactive_color(uint8_t bank, uint8_t encoder, uint8_t color)
+{
+	uint16_t addr = (ENC_SETTINGS_START_PAGE * 32) + (bank * 128) + (encoder * 8) + EE_INACTIVE_COLOR_OFFSET;
