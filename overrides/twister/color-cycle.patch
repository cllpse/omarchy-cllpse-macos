+/** cllpse: the red/blue LED at the ring's 12 o'clock, red and blue each at
+ *  its own level (0..255, PWM over the frames like set_encoder_indent), so it
+ *  can carry a tint taken from the RGB LED's colour beside a white dot.
+ *  set_encoder_indicator_level resets these two bits on every redraw, so the
+ *  caller re-applies this after each one.
+ */
+void set_encoder_indent_rgb(uint8_t encoder, uint8_t red, uint8_t blue)
+{
+	uint8_t *ptr = display_frame_buffer;
+	ptr += ((15-encoder)*2);
+	for (uint8_t i=0;i<NUM_OF_FRAMES;++i)
+	{
+		*ptr |= 0x03;
+		uint8_t value = (i << 1)*(127/NUM_OF_FRAMES);
+		if (blue > value){
+			*ptr &= ~0x01;
+		}
+		if (red > value){
+			*ptr &= ~0x02;
+		}
+		ptr += 32;
+	}
+}
