{
  "workbench.startupEditor": "none",
  "editor.fontLigatures": false,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "editor.colorDecorators": false,
  "editor.copyWithSyntaxHighlighting": false,
  "editor.minimap.enabled": false,
  "editor.minimap.maxColumn": 0,
  "workbench.tips.enabled": false,
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.editor.tabSizing": "fixed",
  "window.restoreWindows": "all",
  "window.newWindowDimensions": "maximized",
  "keyboard.touchbar.enabled": false,
  "breadcrumbs.enabled": false,
  "editor.renderControlCharacters": false,
  "editor.renderWhitespace": "none",
  "editor.rulers": [],
  "editor.lineNumbers": "interval",
  "diffEditor.renderIndicators": false,
  "editor.tabSize": 2,
  "workbench.tree.indent": 20,
  "javascript.updateImportsOnFileMove.enabled": "never",
  "explorer.confirmDragAndDrop": false,
  "scm.diffDecorationsGutterWidth": 5,
  "scm.diffDecorations": "gutter",
  "editor.renderLineHighlight": "all",
  "security.workspace.trust.untrustedFiles": "open",
  "css.hover.references": false,
  "less.hover.references": false,
  "scss.hover.references": false,
  "html.hover.references": false,
  "editor.bracketPairColorization.enabled": false,
  "editor.inlineSuggest.enabled": true,
  "typescript.updateImportsOnFileMove.enabled": "never",
  "html.autoCreateQuotes": false,
  "editor.unicodeHighlight.allowedCharacters": {
    "–": true
  },
  "window.titleBarStyle": "custom",
  "window.menuBarVisibility": "hidden",
  "window.controlsStyle": "hidden",
  "json.maxItemsComputed": 0,
  "editor.fontFamily": "'ComicCode Nerd Font', monospace",
  "editor.fontWeight": "600",
  "editor.fontSize": 15,
  "terminal.integrated.fontFamily": "monospace",
  "explorer.compactFolders": false,
  "editor.formatOnSave": true,
  "git.openRepositoryInParentFolders": "never",
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": false,
  "workbench.layoutControl.enabled": false,
  "workbench.agentsWindowButton.enabled": false,
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "Bearded Theme Vivid Light",
  "workbench.preferredDarkColorTheme": "Bearded Theme Black & Gold Soft",
  "workbench.iconTheme": "bearded-icons",
  "update.showReleaseNotes": false,
  "extensions.ignoreRecommendations": true,
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "cursor.inlineDiff.mode": "unified"
}
