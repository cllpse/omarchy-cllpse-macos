# The DSC bit rate forced on the Samsung TV's link at 4K120, installed to
# /etc/default/cllpse-dsc and read by /usr/local/bin/cllpse-dsc-bpp.
# See overrides/dsc/README.md for the measurements behind each value.

# Sixteenths of a bit per pixel, in hex: amdgpu's debugfs format. 0x140 = 20 bpp,
# 1.2:1 for 8-bit RGB, where amdgpu picks 12 (2:1) on its own. Seen on screen
# for 40 seconds on 2026-10-12 with no difference anyone could see; the ceiling
# the link carries at 4K120 is 0x14E (20.875 bpp), left alone for margin.
DSC_BPP_X16=0x140

# Only modes up to this pixel clock (kHz) carry 20 bpp on 4 lanes of HBR3:
# the TV's own 4K100 and 4K120 (1188 MHz). 4K144 (1333 MHz) and 4K165 (1543 MHz)
# would not fit, and amdgpu rejects such a modeset outright.
DSC_MAX_CLOCK_KHZ=1188000

# The TV, by EDID manufacturer id and product code. 30707 is the HDMI 2.1 EDID
# it serves with Input Signal Plus on; with it off the code is 30706 and there
# is no 4K120 to compress.
DSC_EDID=SAM:30707

# The adapter that decodes the stream, by USB vendor:product: the Synaptics
# VMM7100 USB-C -> HDMI 2.1 converter. Its decoder states 14 bpp as its maximum.
DSC_ADAPTER_USB=06cb:7100
