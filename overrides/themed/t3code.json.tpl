{
  "name": "Omarchy",
  "appearance": "{{ mode }}",
  "canvas": "{{ background }}",
  "accent": "{{ accent }}",
  "colors": {
    "chrome": "{{ background }}",
    "toolbar": "{{ background }}",
    "toolbarForeground": "{{ foreground }}",
    "toolbarBorder": "{{ muted }}",
    "toolbarControl": "{{ mix background foreground 6% }}",
    "toolbarControlForeground": "{{ foreground }}",
    "toolbarControlHover": "{{ mix background foreground 10% }}",

    "surface": "{{ mix background foreground 3% }}",
    "surfaceRaised": "{{ mix background foreground 5% }}",
    "surfaceOverlay": "{{ mix background foreground 7% }}",
    "secondary": "{{ mix background foreground 8% }}",
    "secondaryForeground": "{{ foreground }}",
    "muted": "{{ mix background foreground 5% }}",
    "accentSurface": "{{ mix background foreground 8% }}",
    "accentSurfaceForeground": "{{ foreground }}",
    "messageSurface": "{{ mix background foreground 8% }}",
    "messageForeground": "{{ foreground }}",

    "text": "{{ foreground }}",
    "textMuted": "{{ dark_foreground }}",
    "mutedForeground": "{{ dark_foreground }}",
    "placeholder": "{{ dark_foreground }}",
    "secondaryLabel": "{{ dark_foreground }}",
    "iconMuted": "{{ dark_foreground }}",
    "border": "{{ muted }}",
    "input": "{{ muted }}",
    "focus": "{{ accent }}",
    "accentForeground": "#FFFFFF",
    "messageAction": "{{ accent }}",
    "messageActionForeground": "#FFFFFF",
    "messageActionHover": "{{ mix accent background 12% }}",
    "update": "{{ accent }}",
    "updateForeground": "{{ mix accent foreground 25% }}",
    "updateSurface": "{{ mix background accent 15% }}",

    "sidebar": "{{ dark_background }}",
    "sidebarForeground": "{{ foreground }}",
    "sidebarMutedForeground": "{{ dark_foreground }}",
    "sidebarBorder": "{{ muted }}",
    "sidebarControlSurface": "{{ mix dark_background foreground 6% }}",
    "sidebarRowHover": "{{ mix dark_background foreground 6% }}",
    "sidebarRowActive": "{{ mix dark_background accent 18% }}",
    "sidebarRowSelected": "{{ selection }}",

    "error": "{{ mix red foreground 35% }}",
    "errorForeground": "{{ mix red foreground 35% }}",
    "errorSurface": "{{ mix background red 15% }}",
    "warning": "{{ mix yellow foreground 35% }}",
    "warningForeground": "{{ mix yellow foreground 35% }}",
    "warningSurface": "{{ mix background yellow 15% }}",

    "codeBackground": "{{ dark_background }}",
    "codeForeground": "{{ foreground }}",

    "terminalBackground": "{{ background }}",
    "terminalForeground": "{{ foreground }}",
    "terminalCursor": "{{ bright_foreground }}",
    "terminalSelection": "{{ selection }}",
    "terminalScrollbar": "{{ muted }}",
    "terminalScrollbarHover": "{{ dark_foreground }}"
  }
}
