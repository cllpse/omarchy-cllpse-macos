#!/bin/bash
# Tell Chromium which cllpse-macos theme to show, or take ours out of the way.
# Installed root-owned to /usr/local/bin by chromium-theme.sh, and run without a
# password through /etc/sudoers.d/cllpse-chromium-theme, which names exactly
# the three invocations below. Modelled on Omarchy's
# omarchy-theme-set-browser-policy.
#
#   cllpse-chromium-theme-policy light|dark   write our policy file with that mode
#   cllpse-chromium-theme-policy off          delete it (Omarchy's colour applies)
#
# Exit 3 means "already so, nothing written": the caller then skips refreshing
# Chromium, and since the file was not touched, Chromium's own inotify watch on
# the policy directory has nothing to reload either (README.md §7.6).
#
# The policy is the same for both modes except one value. Both themes are
# installed as normal_installed and the switcher extension as force_installed,
# always. The mode goes to the switcher through the "3rdparty" section, and the
# switcher enables the matching theme. A theme applied by being enabled raises
# no "Installed theme" bar. Changing a theme's installation_mode instead would
# move it between install locations, which Chromium does by reinstalling it.
# That was tried, and it raised the bar and applied the wrong theme
# (README.md §7.5).
#
# The caller chooses a word, never a path or an id. The ids and the update
# manifests are read from root-owned files that chromium-theme.sh installed, so
# a user-level process cannot make Chromium install something else.
# Refreshing the running browser is the caller's job, done unprivileged
# (hooks/theme-set.d/chromium-theme.sh).
set -euo pipefail

# Under sudo, secure_path decides where bare names resolve. Pin it, as Omarchy
# does, so nothing resolves out of a user-writable directory.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

SHARE=/usr/local/share/cllpse-macos/chromium-theme
DIR=/etc/chromium/policies/managed
# Sorts after Omarchy's color.json, so its "BrowserThemeColor": "" wins the
# merge (overrides/chromium-theme/README.md §5).
DEST=$DIR/zz-cllpse-macos-theme.json

usage() { echo "usage: cllpse-chromium-theme-policy light|dark|off" >&2; exit 1; }
(( $# == 1 )) || usage
(( EUID == 0 )) || { echo "cllpse-chromium-theme-policy: needs root" >&2; exit 1; }

# Only a Chromium that Omarchy (or apply.sh) gave a policy root has one.
[[ -d $DIR && ! -L $DIR ]] || exit 0

case $1 in
  off)
    [[ -e $DEST || -L $DEST ]] || exit 3
    rm -f -- "$DEST"
    exit 0
    ;;
  light | dark) mode=$1 ;;
  *) usage ;;
esac

declare -A id
for m in light dark switcher; do
  id[$m]=$(<"$SHARE/$m.id")
  [[ ${id[$m]} =~ ^[a-p]{32}$ ]] ||
    { echo "cllpse-chromium-theme-policy: bad id in $SHARE/$m.id" >&2; exit 1; }
  [[ -f $SHARE/$m.xml && -f $SHARE/$m.crx ]] ||
    { echo "cllpse-chromium-theme-policy: $SHARE/$m.{xml,crx} missing" >&2; exit 1; }
done

staged=$(mktemp)
trap 'rm -f "$staged"' EXIT
# ExtensionSettings, not ExtensionInstallForcelist: cllpse-macos.json sets the
# forcelist, and the same key in two files is not merged -- one replaces the
# other, which would drop those extensions.
printf '%s\n' \
  '{' \
  '  "ExtensionSettings": {' \
  "    \"${id[light]}\": { \"installation_mode\": \"normal_installed\", \"update_url\": \"file://$SHARE/light.xml\" }," \
  "    \"${id[dark]}\": { \"installation_mode\": \"normal_installed\", \"update_url\": \"file://$SHARE/dark.xml\" }," \
  "    \"${id[switcher]}\": { \"installation_mode\": \"force_installed\", \"update_url\": \"file://$SHARE/switcher.xml\" }" \
  '  },' \
  '  "BrowserThemeColor": "",' \
  '  "3rdparty": { "extensions": {' \
  "    \"${id[switcher]}\": { \"mode\": \"$mode\", \"light\": \"${id[light]}\", \"dark\": \"${id[dark]}\" }" \
  '  } }' \
  '}' >"$staged"

if [[ -f $DEST && ! -L $DEST ]] && cmp -s "$staged" "$DEST"; then
  exit 3
fi
[[ -L $DEST || -d $DEST ]] && rm -rf -- "$DEST"
install -m 0644 -o root -g root -T "$staged" "$DEST"
