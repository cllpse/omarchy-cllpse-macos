{
  "manifest_version": 3,
  "name": "cllpse-macos theme (scaffold)",
  "version": "0.0.5",
  "description": "Scaffold: the light theme's lightest grey and white; unfocused windows take the inactive-border grey instead. Hand-copied. See ../README.md.",
  "theme": {
    "colors": {
      "frame": [246, 246, 246],
      "frame_inactive": [189, 189, 189],

      "toolbar": [255, 255, 255],
      "tab_text": [0, 0, 0],
      "toolbar_text": [0, 0, 0],
      "toolbar_button_icon": [0, 0, 0],

      "background_tab": [246, 246, 246],
      "background_tab_inactive": [189, 189, 189],
      "tab_background_text": [0, 0, 0],
      "tab_background_text_inactive": [0, 0, 0]
    }
  }
}
